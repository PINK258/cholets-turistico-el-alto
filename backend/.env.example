# Copia este archivo a ".env" y completa los valores reales. Nunca subas ".env" a git.

DATABASE_URL="postgresql://usuario:clave@localhost:5432/turismo_el_alto?schema=public"

JWT_SECRET="genera-un-secreto-largo-y-aleatorio-aqui"
JWT_EXPIRES_IN="7d"

# Chatbot: modelo local servido por Ollama (https://ollama.com).
# Requiere: ollama pull qwen2.5:1.5b
OLLAMA_URL="http://localhost:11434"
# Modelo afinado (fine-tuning): "cholets-qwen" (ver CODIGO/finetuning/README.md).
# Modelo original sin afinar: "qwen2.5:1.5b".
OLLAMA_MODEL="qwen2.5:1.5b"
OLLAMA_TIMEOUT_MS=20000

PORT=3001
FRONTEND_URL="http://localhost:3000"

# "Continuar con correo": Gmail que envia los codigos (contraseña de aplicacion de 16 letras).
CORREO_USUARIO="tucuenta@gmail.com"
CORREO_CLAVE_APP="abcd efgh ijkl mnop"
