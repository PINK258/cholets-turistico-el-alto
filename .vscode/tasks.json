{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: iniciar",
      "type": "shell",
      // Modo "watch": al cambiar el codigo se recompila y se reinicia solo,
      // asi el backend nunca queda corriendo una version vieja.
      "command": "npx nest start --watch",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "servidores"
      }
    },
    {
      "label": "Backend: compilar",
      "type": "shell",
      "command": "npx nest build",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Frontend: iniciar",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "servidores"
      }
    },
    {
      "label": "Iniciar todo (backend + frontend)",
      "dependsOn": ["Backend: iniciar", "Frontend: iniciar"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
